# 이 파일을 .env.local로 복사한 뒤 값을 채웁니다. (.env.local은 GitHub에 올라가지 않습니다)
# Supabase URL과 키가 비어 있으면 백엔드 없이 연습용 데이터(목업)로 동작합니다.

# 백엔드(FastAPI) 주소
VITE_API_BASE_URL=http://localhost:8000

# Supabase 대시보드 > Project Settings > API에서 확인 (공개용 anon/publishable 키만 넣기, service role 키는 절대 금지)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true로 두면 키가 있어도 목업으로 동작합니다.
VITE_USE_MOCK=false
